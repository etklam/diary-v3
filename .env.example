# Required by the API. Treat the URL as a secret outside local development.
DATABASE_URL=postgresql://diary:diary_local@127.0.0.1:55433/diary_v3
# Generate a random secret of at least 32 bytes before running outside tests.
JWT_SECRET=

# Local API and web origins. Production must set WEB_ORIGIN to its public site
# origin and API_ORIGIN to the internal API service origin used by Web SSR.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3101
WEB_ORIGIN=http://127.0.0.1:3100
API_ORIGIN=http://127.0.0.1:3101
HOST=127.0.0.1
PORT=3000
TRUST_X_FORWARDED_FOR=false

# Optional. Use fixture only in isolated tests; production uses the live provider.
MARKET_PROVIDER=yahoo
# SEC EDGAR automated access: application name plus monitored contact email.
SEC_USER_AGENT="Diary-v3 SEC filings contact@example.com"

# AI reports remain disabled until an Admin publishes tested settings and grants access.
# Set identical keyrings on API and worker; each JSON value is a base64 32-byte key.
# Keep prior versions through snapshot and backup retention. Never commit real keys.
AI_ENCRYPTION_KEYS={}
AI_ENCRYPTION_ACTIVE_KEY=
# Exact HTTPS host/port/base-path allowlist for AI reports and Research Studio.
# Article translation endpoints are configured per provider in the Admin panel.
AI_ALLOWED_BASE_URLS=https://api.deepseek.com
# Research generation uses the same encrypted keyring as AI reports. Keep its
# worker stopped until Research Studio's runtime and provider gates are enabled.
RESEARCH_WORKER_ID=research-worker-local
RESEARCH_WORKER_POLL_MS=5000
