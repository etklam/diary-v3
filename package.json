{
  "name": "diary-v3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace=@diary/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && npm run build --workspace=@diary/web && node --import tsx scripts/build-api.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "contracts:generate": "node --import tsx scripts/generate-openapi.ts && openapi-typescript openapi/openapi.json -o packages/api-client/src/generated.ts",
    "contracts:check": "node --import tsx scripts/generate-openapi.ts --check && openapi-typescript openapi/openapi.json -o packages/api-client/src/generated.ts --check",
    "start:api": "node --env-file-if-exists=.env dist/api/server.js",
    "market:rotation": "node --env-file-if-exists=.env --import tsx apps/api/src/rotation-cli.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@hono/node-server": "2.1.1",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "jose": "6.1.3",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "8.3.1",
    "remark-gfm": "4.0.1",
    "yahoo-finance2": "4.0.2",
    "zod": "4.5.4"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.3.1",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
